{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "ptavant/laravel-firebird",
  "description": "Enhanced Firebird database driver for Laravel — Firebird 2.5-5.0, Dialect 1 & 3, version-aware grammar. Based on harrygulliford/laravel-firebird.",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/support": "^12.17|^13.0",
    "illuminate/container": "^12.17|^13.0",
    "illuminate/database": "^12.17|^13.0",
    "illuminate/events": "^12.17|^13.0"
  },
  "require-dev": {
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^11.5|^12.0",
    "orchestra/testbench": "^10.3|^11.0",
    "fakerphp/faker": "^1.24"
  },
  "archive": {
    "exclude": [
      "/tests"
    ]
  },
  "autoload": {
    "psr-4": {
      "HarryGulliford\\Firebird\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "HarryGulliford\\Firebird\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "HarryGulliford\\Firebird\\FirebirdServiceProvider"
      ]
    }
  }
}
